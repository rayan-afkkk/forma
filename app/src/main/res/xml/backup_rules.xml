<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. -->
<full-backup-content>
    <include domain="database" path="forma.db" />
    <include domain="file" path="datastore/" />
    <!-- Entitlement is re-checked with Google Play; a cached copy must not move between devices. -->
    <exclude domain="file" path="datastore/billing.preferences_pb" />
</full-backup-content>
